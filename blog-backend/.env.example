# ============================================
# 生产环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到版本控制系统
# ============================================

# 服务器配置
SERVER_PORT=8080

# 数据库配置
DB_URL=jdbc:mysql://your-db-host:3306/blog_forum?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis 配置
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=3

# 邮件配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_email_auth_code

# JWT 配置（请生成强密钥，至少32位）
JWT_SECRET=your-very-strong-secret-key-at-least-32-characters-long
# 前端/WebSocket 允许的源，生产环境改为实际域名（如 https://oujincong.xyz）
# 若登录返回 403 且响应体为「IP已被封禁」，说明该 IP 被风控封禁，需在 Redis 中删除 banned_ip:<IP> 或通过管理端解封
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
WS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
ALERT_WEBHOOK=

# ip2region 离线IP地理位置库（首次启动自动下载 xdb 文件）
# 国内服务器若 GitHub 下载慢，可手动下载 ip2region.xdb 放到 ./data/ 目录
IP2REGION_DB_PATH=./data/ip2region.xdb
IP2REGION_DB_URL=https://raw.githubusercontent.com/lionsoul2014/ip2region/master/data/ip2region_v4.xdb

# ============================================
# 文件存储配置
# ============================================
# 存储类型：minio 或 oss
# 默认使用 minio，切换到阿里云OSS时改为 oss
STORAGE_TYPE=minio

# MinIO 对象存储配置（当 STORAGE_TYPE=minio 时使用）
MINIO_ENDPOINT=http://your-minio-host:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=blog

# 阿里云OSS配置（当 STORAGE_TYPE=oss 时使用）
# OSS Endpoint，例如：oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
ALIYUN_OSS_BUCKET=your-bucket-name
# 自定义域名（可选），如果配置了CDN加速域名
ALIYUN_OSS_CUSTOM_DOMAIN=

# 高德地图 API Key
AMAP_KEY=your_amap_api_key

# 智谱AI API Key
ZHIPU_API_KEY=your_zhipu_api_key

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=your_github_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
OAUTH_GITHUB_REDIRECT_URI=https://yourdomain.com/api/auth/github/callback
OAUTH_FRONTEND_REDIRECT_BASE=https://yourdomain.com

# Gitee OAuth
OAUTH_GITEE_CLIENT_ID=your_gitee_client_id
OAUTH_GITEE_CLIENT_SECRET=your_gitee_client_secret
OAUTH_GITEE_REDIRECT_URI=https://yourdomain.com/api/auth/gitee/callback
